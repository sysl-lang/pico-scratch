// Ogol on a Raspberry Pi Pico 2 W, over the USB serial port.
//
// **This is now the desktop console with its first three lines swapped**, and that is a smaller
// difference than it used to be. Both build a `sysl.term.edit.Editor` and walk it; the board's reads
// the USB port, the desktop's reads standard input after putting the terminal into cbreak mode. There
// is no mode to change here, because a USB CDC port has no line discipline to get out of the way of —
// which is the reason a line editor had to exist at all.
//
// Until sysl 0.0.38 that editor was `pico2.read_line`, two hundred lines living in the board's
// package because nothing in the standard library would echo a keystroke. Moving it into `sysl.term`
// is what makes these two consoles the same program: the language is developed on a desktop, where a
// test suite runs in fifty milliseconds, and shipped here unchanged.
//
// **`console_in` and `console_out` come from the package now.** They were written out here for a
// while — nine lines wrapping `read_byte` and `write_byte` — because a package is consumed as a
// coordinate and the branch that added them could not be tagged until 0.0.38 existed for it to
// compile against. pico2 v0.0.7 is that tag, so the copy is gone and this file names what it uses.

import sh.sysl.pico2.*
import sh.sysl.ogol.*
import sysl.term.edit.editor

@export("main")
boot() -> int =
    if !init()
        print("the board did not start")
        return 1

    // A board prints into nowhere until a host attaches, because the SDK discards stdio output with
    // no reader — so the banner is written after this and not before.
    wait_for_terminal()

    print("Ogol on a Raspberry Pi Pico 2 W. Type a line.")
    print("")

    var input = console_in()
    var output = console_out()
    var ed = editor(&input, &output)
    var interp = ogol()

    // What has been typed and not yet run, because it was not finished.
    var pending = ""

    prints("ogol> ")

    // The walk does not end: a serial port has no end of input, so `read` blocks rather than
    // answering empty, and the editor goes on handing back lines for as long as the board is powered.
    for line in ed
        var src = if pending == "" then line else pending + "\n" + line

        pending = ""

        run(interp, src) match
            Ok(v) ->
                v match
                    Nothing -> ()
                    _ -> print(render(v))
            Err(f) ->
                f match
                    More -> pending = src
                    Bad(message) -> print(message)

        prints(if pending == "" then "ogol> " else ".... ")

    0
end boot
