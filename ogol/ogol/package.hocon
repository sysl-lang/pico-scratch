// Ogol on the board — the language over the USB serial port.

package {
  name    = "ogol-pico"
  version = "0.1.0"
}

// **`sh.sysl.ogol` is not here, and that is the one thing still missing.** `sysl-lang/ogol` is not
// tagged yet, so it arrives by `--lib` from the checkout beside this one -- the same arrangement
// `wifi/` has with the unreleased half of `pico2`, and the same cost, which is that this project
// does not build from a fresh clone.
//
// `sh.sysl.pico2` is a coordinate again as of **sysl 0.0.37**. It had to stop being one for a while,
// which was card `0055`: a `--lib` root shadowed the sub-modules of a coordinate dependency binding
// the same top-level name, and every package in this org binds `sh` -- so the two together reported
// `no module is called 'sh.sysl.pico2.externs'` from inside the cached package. An older sysl still
// needs the two-`--lib` workaround this comment used to describe.
dependencies {
  pico2 { git = "github.com/sysl-lang/pico2", version = "0.0.7" }
}

// The heap is the language's, not this program's. An interpreter grows a token list, a tree and a
// dictionary as the person at the keyboard decides how big they should be, and the sizes of all three
// are what a `Buf` exists to not have to guess. The SDK links newlib's allocator whether or not a
// program touches it, so what this declares is honest rather than expensive.
requires {
  alloc = true
}
