// A REPL on the Pico 2 W, over the USB serial port.
//
// The point of this one is *input*, which nothing else here touches — and input turned out to be
// where a board stops resembling a hosted machine.
//
// **`sysl.io`'s line cursor is the wrong tool for a console.** It splits on `\n`, which is right for
// a pipe and wrong for a terminal: `screen` sends a bare `\r` when Enter is pressed, so a program
// reading lines that way waits forever and looks dead. It was tried first and did exactly that —
// three commands arrived as the single line `help\rhelp\rhelp`.
//
// **What answers it is `sysl.term.edit`, the standard library's editor rather than this board's.**
// For a while it was `pico2.read_line` — two hundred lines of insertion, backspace and arrow keys
// living in the board's package, because nothing shipped with the language would echo a keystroke.
// pico2 v0.0.7 gives the editor up and supplies the *port* instead: `ConsoleIn` and `ConsoleOut`, a
// `Reader` and a `Writer` over USB CDC. So what runs here is what runs at a desktop terminal, and
// only those two types are the board's.
//
// **And a board prints into nowhere until a host attaches**, because the SDK discards stdio output
// with no reader — so the banner is written after `wait_for_terminal`, not before.
//
// It allocates, and says so: the editor grows the line as it is typed, and `split` answers a
// `[]string`. The heap is newlib's, which the SDK links, so it is there whether or not this program
// uses it — but `package.hocon` still declares `heap = true`, because that is a claim about what
// the code does rather than a request for something to exist.

import sh.sysl.pico2.*
import sysl.term.edit.editor
import sysl.text.{split, parse_int}
import sysl.time.DurationUnits

prompt() = prints("sysl> ")

help() =
    print("  led on | led off    the onboard LED, which is on the wireless chip")
    print("  fib N               the Nth Fibonacci number, as 64-bit arithmetic")
    print("  usb                 whether the board is running on USB power")
    print("  help                this")

fib(n: int) -> long =
    var a: long = 0
    var b: long = 1

    for _ in 0..<n
        a, b = b, a + b

    a

// The E in REPL: answers the one line given, and says so when it cannot.
eval(line: string) =
    val word = split(line, " ")

    if word.len == 0 then return

    word[0] match
        "" -> return
        "help" -> help()
        "usb" -> print(if on_usb_power() then "on USB power" else "on its own supply")

        "led" if word.len != 2 -> print("led needs 'on' or 'off'")
        "led" ->
            word[1] match
                "on" -> led(true)
                "off" -> led(false)
                _ -> print(s"led does not understand '${word[1]}'")

        "fib" if word.len != 2 -> print("fib needs a number")
        "fib" ->
            parse_int(word[1]) match
                Ok(n) -> print(s"fib($n) = ${fib(n)}")
                Err(_) -> print(s"'${word[1]}' is not a number")

        _ -> print(s"'${word[0]}' is not a command — try 'help'")
end eval

@export("main")
run() -> int =
    if !init()
        print("the wireless chip did not start")
        return 1

    wait_for_terminal()

    print("sysl on a Raspberry Pi Pico 2 W. Type 'help'.")
    print("")

    var input = console_in()
    var output = console_out()
    var ed = editor(&input, &output)

    // The prompt is the caller's, because every movement the editor makes is relative and it never
    // learns how far along the row a line starts. So one before the first read, and one after each
    // line is answered.
    prompt()

    for line in ed
        eval(line)
        prompt()

    // Reached only if the port ends, which a USB CDC console does not do while a host is attached.
    // A board has nowhere to return *to* either, so the request is answered rather than obeyed.
    print("")
    print("input ended — reset the board")

    loop
        sleep(1.s)
end run
