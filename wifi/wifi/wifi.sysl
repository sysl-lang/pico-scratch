// Wi-Fi on the Pico 2 W, driven from the USB serial port.
//
// The point of this one is the *radio*, which nothing else here touches. It is the `repl/` shape with
// a different command set, deliberately: the line editor, the CR/LF handling and the banner were all
// settled there, so what is left on screen is the part that is new.
//
// **This links `pico_cyw43_arch_lwip_threadsafe_background`, where `repl/` links
// `pico_cyw43_arch_none`.** Two reasons, and the first is not optional: joining waits for the link to
// come *up*, which is a question only lwIP can answer, so with no stack linked the radio associates
// and nothing is ever able to report it. The second is why the *background* variant rather than the
// polling one — this program spends nearly all of its life blocked inside `read_line`, and the
// polling variant would run the driver only between keystrokes.
//
// **A successful `join` means there is a DHCP lease**, not merely that the radio associated. That is
// the SDK's definition of link-up and it is the useful one: the board is on the network.
//
// **`ip` reads that lease back**, which is what makes the join checkable from the other end: the
// board can be pinged from the laptop the moment it prints an address, since lwIP answers ICMP with
// no code here at all. What is still missing is *using* the connection — opening a socket, or
// fetching something — and see `sh.sysl.pico2` for where that line currently sits.

import sh.sysl.pico2.*
import sysl.text.split
import sysl.time.{Duration, DurationUnits}

prompt() = prints("wifi> ")

help() =
    print("  list                 every network the radio can hear")
    print("  join SSID PASSWORD   join a WPA2 network")
    print("  open SSID            join a network that has no password")
    print("  ap SSID PASSWORD     become an access point instead")
    print("  ip                   the address the board is answering on")
    print("  leave                leave the network")
    print("  country              the regulatory country the radio is set to")
    print("  led on | led off     the onboard LED, which is on the wireless chip")
    print("  help                 this")

// How long to wait before giving up on a join.
//
// **Twenty seconds is long, and it has to be.** A join is an association, a four-way handshake and a
// DHCP exchange, and a router that is busy can take most of that. A short timeout here reports a
// working network as broken, which is the worst answer available.
// A function rather than a `const`, because `20.s` is a call too -- a property is a member with no
// parameter list, not a literal -- and a `const` must be something the compiler can fold. A module
// `val` would also work and would be storage this does not need.
private join_wait() -> Duration = 20.s

// Every network within earshot, strongest first is *not* what this does — they come back in the
// order they were first heard, which is near enough and keeps the demo honest about what the package
// gives it.
//
// **The scan takes a few seconds and the prompt does not come back until it is done.** Saying so
// first matters more here than anywhere else in this program: a REPL that goes quiet for three
// seconds looks like the wedged board that `repl/` was written to stop happening.
list_networks() =
    print("scanning...")

    val found = scan(4.s)

    if found.len == 0
        print("  nothing answered")
        return

    for n in found
        print(s"  ${n.ssid}")
        print(s"      channel ${n.channel}, ${n.rssi} dBm${if n.auth_code == 0 then ", open" else ""}")

    if scan_was_truncated()
        print("  ...and more than there was room for")
end list_networks

// Where the board is on the network — **the command that makes a join checkable from somewhere other
// than this prompt.** `joined` is a claim; an address is something to ping.
//
// The link is printed whether or not there is an address, because it is what says which kind of
// nothing an absent address is: a lease still on its way, or no connection to have asked for one.
show_address() =
    print(s"  link    ${link()}")

    ip() match
        Some(a) ->
            print(s"  address $a")
            named("netmask", netmask())
            named("gateway", gateway())

        None -> print("  no address — 'join' first, and give it a moment")
end show_address

// A line that is only printed when there is something on it. The netmask and the gateway arrive as
// `Option` for the same reason the address does, and neither is worth a line saying it is missing —
// an address without them is the interesting case, and it says so by their absence.
private named(label: string, value: Option[Ipv4]) =
    value match
        Some(v) -> print(s"  $label $v")
        None -> ()

// The one place a join's outcome is turned into words.
//
// `JoinError` renders itself, so this says what happened and lets the error say why.
report(what: string, outcome: Result[unit, JoinError]) =
    outcome match
        Ok(_) -> print(s"joined $what")
        Err(e) -> print(s"could not join $what — $e")

eval(line: string) =
    val word = split(line, " ")

    if word.len == 0 then return

    word[0] match
        "" -> return
        "help" -> help()
        "list" -> list_networks()
        "country" -> print(s"the radio is set to ${country()}")
        "ip" -> show_address()
        "leave" ->
            leave()
            print("left the network")

        "join" if word.len != 3 -> print("join needs an SSID and a password")
        "join" ->
            print(s"joining ${word[1]}...")
            report(word[1], join(word[1], word[2], Wpa2, join_wait()))

        "open" if word.len != 2 -> print("open needs an SSID")
        "open" ->
            print(s"joining ${word[1]}...")
            report(word[1], join_open(word[1], join_wait()))

        "ap" if word.len != 3 -> print("ap needs an SSID and a password")
        "ap" ->
            access_point(word[1], word[2], Wpa2)
            print(s"${word[1]} is up — nothing here hands out addresses, so a client will")
            print("associate and then wait for a DHCP lease that is not coming")

        "led" if word.len != 2 -> print("led needs 'on' or 'off'")
        "led" ->
            word[1] match
                "on" -> led(true)
                "off" -> led(false)
                _ -> print(s"led does not understand '${word[1]}'")

        _ -> print(s"'${word[0]}' is not a command — try 'help'")
end eval

@export("main")
run() -> int =
    if !init()
        print("the wireless chip did not start")
        return 1

    wait_for_terminal()

    print("sysl on a Raspberry Pi Pico 2 W — Wi-Fi. Type 'help'.")
    print("")

    loop
        prompt()
        eval(read_line())
