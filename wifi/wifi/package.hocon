// Wi-Fi over the board's USB serial port.

package {
  name    = "wifi"
  version = "0.1.0"
}

// **0.0.6 is the first `pico2` with a radio in it**, which is why this names a later version than
// `repl/` beside it: association, scanning, the DHCP readback, name resolution and the fetch all
// arrived together in that tag. `repl/` wants none of them and has no reason to move.
dependencies {
  pico2 { git = "github.com/sysl-lang/pico2", version = "0.0.6" }
}

requires {
  alloc = true
}
