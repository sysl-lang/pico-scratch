// sysl on a Pico 2 W, hosted by the C SDK, with the board itself coming from a package.
//
// There is no C in this project at all. The SDK supplies the board — the linker script, the vector
// table, the boot block, the clocks, and the `crt0` that calls `main` — and `sh.sysl.pico2` declares
// the entry points, so everything below is sysl.
//
// Printing needs nothing declared here: sysl's `print` reaches `putchar`, and under the SDK that is
// newlib's, wired to the USB serial port.

import sh.sysl.pico2.*
import sysl.time.{Duration, millis}

// Rendering a 64-bit number divides by ten, and a Cortex-M33 has no 64-bit divide instruction — so
// printing this also checks that the ARM EABI helper the toolchain supplies is reachable.
fib(n: u32) -> long =
    var a: long = 0
    var b: long = 1
    var i: u32 = 0

    while i < n
        val next = a + b

        a = b
        b = next
        i += 1

    a

flash(on: Duration, off: Duration) =
    led(true)
    sleep(on)
    led(false)
    sleep(off)

// The program's entry point, published under the plain C name the SDK's `crt0` branches to.
// `@export` is what makes a bare `main` symbol rather than sysl's own decorated one, and it is also
// the reachability root — a `build-c` has no entry point of its own, so without an export the whole
// module prunes away and the compiler says so.
//
// The `int` costs nothing because `loop` diverges: the body never falls off the end, so there is no
// unreachable `return 0` to write, and `crt0` gets the honest signature rather than `void main`.
@export("main")
run() -> int =
    if !init()
        print("the wireless chip did not start")
        return 1

    print("hello from sysl, running on an RP2350")

    var n: u32 = 0

    loop
        flash(millis(120), millis(120))
        flash(millis(120), millis(640))
        print(s"tick $n, fib($n) = ${fib(n)}")
        n += 1
